# Postgres (Neon / Supabase / local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/adcraft

# Auth.js
AUTH_SECRET=change-me-run-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email (magic links via Resend)
RESEND_API_KEY=
EMAIL_FROM=Adcraft <login@adcraft.app>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adcraft-media

# AI providers
ANTHROPIC_API_KEY=
FAL_KEY=

# Ad platforms (Release 4). Leave blank to use the built-in sandbox providers.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: base64 of 32 random bytes; otherwise derived from AUTH_SECRET
TOKEN_ENCRYPTION_KEY=

# Video and UGC (Release 2)
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Adcraft — local environment
# Every key the app can use. Blank = that integration is off (the app falls back
# to sandbox / offline behaviour where it can). Admin → Providers shows the same
# list with live status; Admin → Models lets you add models per provider.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/adcraft

# ── Auth (Auth.js) ────────────────────────────────────────────────────────────
AUTH_SECRET=change-me-run-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Google sign-in (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local only: set to 0 to hide the dev sign-in box on /sign-in
DEV_LOGIN=
# Comma-separated emails promoted to platform admin on sign-in
ADMIN_EMAILS=

# ── Email (magic links, invites) — Resend ────────────────────────────────────
RESEND_API_KEY=
# Must be a domain verified in Resend
EMAIL_FROM=Adcraft <login@example.com>

# ── Billing — Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Local: `stripe listen --api-key $STRIPE_SECRET_KEY --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_STUDIO_MONTH=
STRIPE_PRICE_STUDIO_YEAR=
STRIPE_PRICE_AGENCY_MONTH=
STRIPE_PRICE_AGENCY_YEAR=
STRIPE_PRICE_TOPUP=

# ── Background jobs — Inngest ────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local only: send events to the Inngest Dev Server (`pnpm inngest`, http://localhost:8288). Remove in production.
INNGEST_DEV=

# ── Media storage — Cloudflare R2 (blank = local disk) ───────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adcraft-media
# Local disk location when R2 is blank (default: apps/app/.data/storage)
LOCAL_STORAGE_DIR=

# ── AI: text (concepts, copy, scripts) ───────────────────────────────────────
# Anthropic — Claude Opus 5 (default text model), Claude Haiku 4.5
ANTHROPIC_API_KEY=
# OpenAI — GPT text models and GPT Image 2.5 Sunburst / Flare
OPENAI_API_KEY=
# Any other OpenAI-compatible endpoint: add the model in Admin → Models with a base URL
# and the env var name that holds its key, then set that var here. Examples:
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ── AI: images & video ───────────────────────────────────────────────────────
# fal.ai — Nano Banana, Seedream, FLUX, Qwen, GPT Image (via fal), Kling, Veo, Seedance, cutouts
FAL_KEY=
# Replicate — any owner/name image or video model (examples ship disabled in Admin → Models)
REPLICATE_API_TOKEN=
# Runway — Gen-4 Image and Gen-4 Turbo image-to-video (ship disabled; enable after Test)
RUNWAYML_API_SECRET=

# ── AI: UGC voice & presenter ────────────────────────────────────────────────
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=

# ── Ad platforms (blank = built-in sandbox providers) ────────────────────────
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: base64 of 32 random bytes for encrypting ad-account tokens (else derived from AUTH_SECRET)
TOKEN_ENCRYPTION_KEY=

# ── Rendering (usually leave blank) ──────────────────────────────────────────
# Override the bundled ffmpeg / Chromium used by Remotion if the defaults fail on this machine
FFMPEG_PATH=
REMOTION_BROWSER_EXECUTABLE=

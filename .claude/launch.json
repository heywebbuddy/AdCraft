{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@adcraft/app",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "inngest",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "inngest-cli@latest",
        "dev",
        "-u",
        "http://localhost:3000/api/inngest",
        "--no-discovery"
      ],
      "port": 8288
    }
  ]
}
